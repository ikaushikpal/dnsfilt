# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example) - dnsfilt-resolver
# ==============================================================================

RESOLVER_PORT=2053
DNS_PORT=2053

# Redis Configuration
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USER=XXXX
REDIS_PASSWORD=XXXX
REDIS_SSL=false
REDIS_TIMEOUT=2000

REDIS_URL=redis://XXX:XXX@host.docker.internal:6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=XXXX:9092
KAFKA_TOPIC=dns.analytics.10min

KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=kafkaapp
KAFKA_SASL_PASSWORD=YOUR_KAFKA_PASSWORD_HERE

# In-Memory Cache & Engine Configuration
L1_CACHE_MAX_SIZE=10000
L1_CACHE_TTL_MINUTES=5
RULE_CACHE_TTL_MINUTES=2
CLIENT_HASH_SECRET=dnsfilt-secret-hmac-salt-key-2026

# JVM Memory Tuning
JAVA_OPTS=-Xms64m -Xmx160m -XX:MaxMetaspaceSize=40m -XX:+UseG1GC
