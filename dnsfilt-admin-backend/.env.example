# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example) - dnsfilt-admin-backend
# ==============================================================================

ADMIN_BACKEND_PORT=8080
ADMIN_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
DB_URL="jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.ap-mumbai-1.oraclecloud.com))(connect_data=(service_name=your_service_name.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))"
DB_USERNAME=ADMIN
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_DRIVER=oracle.jdbc.OracleDriver

# Redis Configuration
REDIS_URL=redis://appuser:YOUR_REDIS_PASSWORD_HERE@host.docker.internal:6379

# Orchestrator Push Webhook URL
ORCHESTRATOR_URL=http://dnsfilt-orchestrator:8000/internal/reconcile

# Security & JWT Configuration
JWT_SECRET=dnsfilt-admin-backend-jwt-secret-key-32bytes-long-2026
JWT_EXPIRATION_MS=86400000

# JVM Memory Tuning (500MB Container Limit: 320MB Heap + 128MB Metaspace)
JAVA_OPTS=-Xms128m -Xmx320m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC
