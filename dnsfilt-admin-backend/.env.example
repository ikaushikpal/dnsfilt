# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example) - dnsfilt-admin-backend
# ==============================================================================

ADMIN_BACKEND_PORT=8080
ADMIN_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Do NOT wrap in quotes)
DB_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=XXX))(connect_data=(service_name=yXXX))(security=(ssl_server_dn_match=yes)))
DB_USERNAME=XXXX
DB_PASSWORD=XXXX
DB_DRIVER=oracle.jdbc.OracleDriver

# Redis Configuration
REDIS_URL=redis://XXX:XXXX@XXX:6379

# Orchestrator Push Webhook URL
ORCHESTRATOR_URL=http://127.0.0.1:9090/internal/reconcile

# Logging Configuration (2 Weeks / 14 Days Retention)
LOG_DIR=./logs
LOG_RETENTION_DAYS=14

# Security & JWT Configuration
JWT_SECRET=dnsfilt-admin-backend-jwt-secret-key-32bytes-long-2026
JWT_EXPIRATION_MS=86400000

# JVM Memory Tuning (500MB Container Limit: 320MB Heap + 128MB Metaspace)
JAVA_OPTS=-Xms128m -Xmx320m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC
