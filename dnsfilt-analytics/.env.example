# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example) - dnsfilt-analytics
# ==============================================================================

ANALYTICS_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Do NOT wrap in quotes)
DB_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=XXX))(connect_data=(service_name=XXX))(security=(ssl_server_dn_match=yes)))
DB_USERNAME=XXX
DB_PASSWORD=XXXX
DB_DRIVER=oracle.jdbc.OracleDriver

# Kafka / OCI Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=XXX:9092
KAFKA_TOPIC=dns.analytics.10min
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=XXXX
KAFKA_SASL_PASSWORD=XXXX

# Logging Configuration (2 Weeks / 14 Days Retention)
LOG_DIR=./logs
LOG_RETENTION_DAYS=14

# JVM Memory Tuning (500MB Container Limit: 320MB Heap + 128MB Metaspace)
JAVA_OPTS=-Xms128m -Xmx320m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC
