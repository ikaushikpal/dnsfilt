# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example) - dnsfilt-orchestrator
# ==============================================================================

ORCHESTRATOR_PORT=8000

# Backend API URL for desired state queries
BACKEND_API_URL=http://dnsfilt-admin-backend:8080/api/v1

# SQLite database path for actual resolver cluster state tracking
SQLITE_DB_PATH=sqlite:///./data/resolvers.db

# HAProxy integration settings
HAPROXY_CONFIG_PATH=/etc/haproxy/haproxy.cfg
HAPROXY_CONTAINER_NAME=haproxy
HAPROXY_LOCAL_CONFIG=../haproxy/haproxy.cfg

# Resolver container scaling settings
RESOLVER_IMAGE_NAME=dnsfilt-resolver:latest
RESOLVER_PORT_RANGE_START=2054
RESOLVER_PORT_RANGE_END=2090
DOCKER_NETWORK=dnsfilt-network

# Reconciliation interval in seconds
RECONCILE_INTERVAL_SECONDS=60
